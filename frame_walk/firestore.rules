rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUsername(username) {
      return username is string && username.matches('^[A-Za-z0-9_]{3,20}$');
    }

    // Account information and statistics. Only the owner can see or change
    // their own document, and the username can't change after creation.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Must be created together with a matching username reservation.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username == resource.data.username;

      // Completed walks. Kept as history, so clients can't delete them.
      match /walks/{walkId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.userId == uid
          && request.resource.data.keys().hasOnly([
            'userId', 'routeId', 'routeTitle', 'startedAt', 'completedAt',
            'stopIds', 'promptIds', 'stops'
          ])
          && request.resource.data.startedAt is timestamp
          && request.resource.data.completedAt is timestamp;

        // References to photos that stay on the user's device. Only listed
        // fields are allowed, so no image data or other extra fields can be
        // stored.
        match /photoLinks/{linkId} {
          allow read, delete: if request.auth != null && request.auth.uid == uid;

          allow create, update: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.userId == uid
            && request.resource.data.walkId == walkId
            && request.resource.data.keys().hasOnly([
              'userId', 'walkId', 'routeId', 'assetId', 'platform',
              'deviceInstallId', 'takenAt', 'width', 'height', 'stopId',
              'promptId', 'status', 'updatedAt'
            ])
            && request.resource.data.assetId is string
            && request.resource.data.assetId.size() <= 256
            && request.resource.data.status in ['linked', 'removed'];
        }
      }
    }

    // One document per lowercase username, so a name can only be claimed once.
    // Reservations can never be updated or deleted by clients.
    match /usernames/{username} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == username;
    }
  }
}
